# Opcional. O Docker Compose usa estes padrões quando o arquivo .env não existe.
# Copie para .env na raiz apenas para substituir usuário, senha ou nome do banco.
# JWT e dados do administrador ficam em api/.env, lido só em tempo de execução.
# Nenhum desses valores é gravado nas imagens.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=condo_reserva
PORT=3001
VITE_API_URL=http://localhost:3001